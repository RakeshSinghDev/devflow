# DevFlow Backend Production Environment Variable Template (.env.example)
# Configure in Render Environment Settings for backend deployment.

# Active Spring Profile
SPRING_PROFILES_ACTIVE=prod

# Render PostgreSQL Database Connection Settings
DATABASE_URL=jdbc:postgresql://<render-db-host>:5432/<render-db-name>
DATABASE_USERNAME=<render-db-user>
DATABASE_PASSWORD=<render-db-password>

# Application Port (Render automatically sets PORT env var)
PORT=8080

# Security Credentials (JWT secret must be a strong 32+ byte key)
JWT_SECRET=<your-strong-256-bit-random-signing-secret>
JWT_EXPIRATION_MS=86400000

# Vercel Frontend Allowed CORS Origin(s)
FRONTEND_URL=https://<your-vercel-app-name>.vercel.app
