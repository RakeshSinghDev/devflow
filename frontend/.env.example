# DevFlow Frontend Environment Variable Template (.env.example)
# Configure in Vercel Environment Variables settings for production.

# Render Backend API Base URL (e.g. https://devflow-backend.onrender.com/api)
# For local development, set to: http://localhost:8080/api or /api
VITE_API_URL=https://<your-render-backend-app>.onrender.com/api
